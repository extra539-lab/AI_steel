{
  "name": "shophisab-electron",
  "productName": "ShopHisab",
  "version": "1.0.0",
  "private": true,
  "description": "A1 Steel & Cement desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.6.0",
    "app-builder-bin": "4.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "optionalDependencies": {
    "7zip-bin": "5.2.0"
  },
  "build": {
    "electronVersion": "31.7.7",
    "appId": "com.shophisab.app",
    "productName": "ShopHisab",
    "artifactName": "ShopHisab-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin/**"
    ],
    "asarUnpack": [
      "node_modules/axios/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist/",
        "to": "app/frontend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "ShopHisab",
      "publisherName": "A1 Steel & Cement"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [
    "desktop",
    "electron",
    "windows",
    "installer"
  ],
  "author": "A1 Steel & Cement",
  "license": "ISC"
}
